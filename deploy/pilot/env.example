# Copy to ".env" (cp env.example .env) and fill in the gym's address. Read by docker-compose.yml.

# The address members open, without https:// (a domain you own, pointed at this server).
DOMAIN=gym.example.com

# Passkeys (fingerprint / face sign-in) are tied to this exact address.
RP_ID=gym.example.com
ORIGIN=https://gym.example.com
# The name phones show when they save a passkey.
RP_NAME=CADENCE

# The first profile created becomes the owner. Create yours before you share the address.
FIRST_USER_ADMIN=1

# A gym's app: no "Continue without account".
ALLOW_GUEST=0

# Optional: only people with an invite code (made in the admin page) can create a profile.
# INVITE_ONLY=1
